lor-illustration-fill-accent",12,0,""],["--igds-base-color-illustration-fill-backdrop",12,0,""],["igds.light.base.color.button.\nbackground-primary",16,0,""],["igds.light.base.color.button.\nbackground-primary-dark",16,0,""],["igds.light.base.color.button.\nbackground-secondary",16,0,""],["צבעי רקע\nצבעי רקע שנועדו להכיל טקסט לכפתור ולאפשר לו להיות קריא",16,0,""],["רקע למצב default",16,0,""],["רקע למצב default כהה",16,0,""],["צבע רקע משני",16,0,""],["נגיש לשימוש בכל הרקעים הבהירים",14,0,""],["שימו לב: נגיש לשימוש רק על רקע לבן",14,0,""],["לרכיבים סטטיים, למשל numeric badge",14,0,""],["--igds-base-color-button-background-primary",12,0,""],["--igds-base-color-button-background-primary-dark",12,0,""],["--igds-base-color-button-background-secondary",12,0,""],["1",14,0,""],["Graphical element",16,0,""],["איור וקטורי הניתן להגדלה ושומר על איכותו בכל גודל.",16,0,""],["igds.base.color.button.\nbackground-disabled",16,0,""],["igds.light.base.color.button.\ntext-disabled",16,0,""],["igds.light.base.color.button.\nborder-disabled",16,0,""],["צבעי disabled\nצבעי רקע, טקסט וקו מתאר שנועדו לציין שהרכיבים לא פעילים ולא ניתן לקיים איתם אינטרקציה",16,0,""],["2",14,0,""],["Color Palette",16,0,""],["צבעי האיור המבוססים על צבעי המותג.",16,0,""],["2.1",10,0,""],["Stroke",16,0,""],["באיורים בגירסה הצבעונית נעשה שימוש בשלושה צבעים לקווים\nPrimary: הצבע העיקרי של קווי האיור, מקביל לצבע הטקסט הראשי ביצירת בסיס של האיור.\nSecondary: הצבע המשני, שמודגש יותר ומקביל לצבע המותג, מעניק לאיור נוכחות וחיים.\nMotion-effect: נועד להוסיף עניין ויזואלי, בדרך כלל באלמנטים דקורטיביים באיור וניתן לבחירה. ",16,0,""],["רקע למצב disabled",16,0,""],["טקסט למצב disabled",16,0,""],["קו מתאר למצב disabled",16,0,""],["2.2",10,0,""],["Fill",16,0,""],["באיורים בגירסה הצבעונית נעשה שימוש בשלושה צבעים למילוי\nBase: משמש למילוי האלמנטים המרכזיים, לרוב נייטרלי ונועד למלא את הרכיב המרכזי בהאיור.\nAccent: משמש לאלמנטים בולטים באיור, המושכים תשומת לב ומדגישים את צבעי המותג.\nBackdrop: משמש כתמיכה ויזואלית לאיור כולו, מעניק תחושת מסגור או הדגשה למכלול.",16,0,""],["למשל בכפתור או input field",14,0,""],["לרכיבים במצב disabled",14,0,""],["למשל ב-input field",14,0,""],["--igds-base-color-button-background-disabled",12,0,""],["--igds-base-color-button-text-disabled",12,0,""],["--igds-base-color-button-border-disabled",12,0,""],["3",14,0,""],["Alt Text",16,0,""],["טקסט תיאורי לקוראי מסך להבטחת נגישות. ",16,0,""],["*יש להתאים את הצבעים בטבלת ה-Variables, ואין לבצע שינויים ישירים בצבעי האיורים, \nכדי לשמור על אחידות בכל האיורים.",16,0,""],["igds.light.base.color.button.\ntext-primary",16,0,""],["igds.light.base.color.button.\ntext-secondary",16,0,""],["igds.light.base.color.button.\ntext-hover-pressed",16,0,""],["igds.light.base.color.button.\nlink-primary-dark",16,0,""],["צבע טקסט אינטרקטיבי\nלטובת טקסט של לינקים או כפתורים",16,0,""],["טקסט במצב default",16,0,""],["צבע טקסט משני",16,0,""],["לינק במצב hover-pressed",16,0,""],["לינק על רקע כהה",16,0,""],["לשימוש בכפתורים",14,0,""],["לרכיבים סטטיים, למשל numeric badge",14,0,""],["לשימוש בכפתורים",14,0,""],["לשימוש בלינקים",14,0,""],["--igds-base-color-button-text-primary",12,0,""],["--igds-base-color-button-text-secondary",12,0,""],["--igds-base-color-button-text-hover-pressed",12,0,""],["--igds-base-color-button-link-primary-dark",12,0,""],["igds.light.base.color.border.\nsubtle-hover",16,0,""],["igds.light.base.color.border.\nsubtle-default",16,0,""],["קו מתאר נייטרלי\nלטובת מצבי default ו-hover",16,0,""],["קו מתאר במצב hover",16,0,""],["קו מתאר במצב default",16,0,""],["למשל ב-input field",14,0,""],["למשל ב-input field",14,0,""],["--igds-base-color-button-border-primary",12,0,""],["--igds-base-color-button-border-subtle",12,0,""]]]],"chars":11422}